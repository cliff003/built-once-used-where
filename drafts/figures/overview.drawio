        <mxCell id="v34" value="&lt;b&gt;B&lt;/b&gt;&amp;nbsp;&amp;nbsp;How we measured &lt;span style=&quot;color:#5c5b56;font-size:14px&quot;&gt;(rules and code frozen before the data)&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica Neue;fontSize=17;fontColor=#1f1e1c;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
