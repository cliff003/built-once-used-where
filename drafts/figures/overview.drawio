        <mxCell id="v33" value="U2 asks whether uptake is higher on S levels, where kept tools should still apply, than on N levels, where they may mislead (Section 3)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica Neue;fontSize=14;fontColor=#1f1e1c;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
