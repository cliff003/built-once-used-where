        <mxCell id="v35" value="&lt;span style=&quot;color:#5c5b56;font-size:13.5px&quot;&gt;Frozen: predictions on 2026-10-26 (Amendment 3), data plan on 2026-10-27 (Amendments 4 and 5). The analysis ran once, on 2026-11-01.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica Neue;fontSize=13.5;fontColor=#1f1e1c;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="34" y="330" width="856" height="20" as="geometry" />
        </mxCell>
        <mxCell id="v36" value="&lt;b&gt;S/V/N labels for 158 of the 183 public levels&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#5c5b56;font-size:13.5px&quot;&gt;First frames from the official engine, not played. Level 2 onward; one AI annotator, labels frozen; blind check by two members on 44 levels from 7 games.&lt;/span&gt;" style="rounded=1;arcSize=7;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b5b4ae;strokeWidth=1.2;fontFamily=Helvetica Neue;fontSize=14;fontColor=#1f1e1c;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=7;spacingBottom=7;" vertex="1" parent="1">
          <mxGeometry x="10" y="360" width="498" height="96" as="geometry" />
        </mxCell>
        <mxCell id="v37" value="&lt;b&gt;Kaggle run R-06&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#5c5b56;font-size:13.5px&quot;&gt;v1 configuration, submission 57639912; 25 games &amp;#215; 2 passes&lt;/span&gt;" style="rounded=1;arcSize=7;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b5b4ae;strokeWidth=1.2;fontFamily=Helvetica Neue;fontSize=14;fontColor=#1f1e1c;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=7;spacingBottom=7;" vertex="1" parent="1">
          <mxGeometry x="10" y="470" width="150" height="112" as="geometry" />
        </mxCell>
        <mxCell id="v38" value="&lt;b&gt;Sealed transcripts&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#5c5b56;font-size:13.5px&quot;&gt;50 game-runs, all valid; sealed until the frozen analysis had run&lt;/span&gt;" style="rounded=1;arcSize=7;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b5b4ae;strokeWidth=1.2;fontFamily=Helvetica Neue;fontSize=14;fontColor=#1f1e1c;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=7;spacingBottom=7;" vertex="1" parent="1">
          <mxGeometry x="184" y="470" width="150" height="112" as="geometry" />
        </mxCell>
        <mxCell id="v39" value="&lt;b&gt;Frozen parser&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#5c5b56;font-size:13.5px&quot;&gt;kept functions per level; carried calls from the syntax tree&lt;/span&gt;" style="rounded=1;arcSize=7;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b5b4ae;strokeWidth=1.2;fontFamily=Helvetica Neue;fontSize=14;fontColor=#1f1e1c;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=7;spacingBottom=7;" vertex="1" parent="1">
          <mxGeometry x="358" y="470" width="150" height="112" as="geometry" />
        </mxCell>
        <mxCell id="v40" value="&lt;b&gt;U1 and U2&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#5c5b56;font-size:13.5px&quot;&gt;&lt;b&gt;U1&lt;/b&gt;: share of kept functions ever called on a later level&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#5c5b56;font-size:13.5px&quot;&gt;&lt;b&gt;U2&lt;/b&gt;: uptake on S levels minus uptake on N levels&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#5c5b56;font-size:13.5px&quot;&gt;game bootstrap, 90% intervals&lt;/span&gt;" style="rounded=1;arcSize=7;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b5b4ae;strokeWidth=1.2;fontFamily=Helvetica Neue;fontSize=14;fontColor=#1f1e1c;align=left;verticalAlign=middle;spacingLeft=9;spacingRight=9;spacingTop=7;spacingBottom=7;" vertex="1" parent="1">
